{
  // Один воркер: статика фронтенда + API push + cron-рассылка
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-planner",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Без редиректа /index.html → /: Safari не открывает установленное приложение,
    // если service worker отдаёт страницу, полученную через редирект
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixel-planner-push",
      "database_id": "aee4db64-6569-416e-8e90-55bb0ce0c6fb",
      "migrations_dir": "server/migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Публичный ключ VAPID не секретен; приватный задаётся через `wrangler secret put VAPID_PRIVATE_KEY`
    "VAPID_PUBLIC_KEY": "BG2aJWqGkocPPrRDw7lBHAoAvMbi-GG4sKQy5YMt-ECOTXnQRMCJMC-V0VPcQbQbk0KTKa_BMGoCjZujwko-140",
    "VAPID_SUBJECT": "https://pixel-planner.pixel-planner.workers.dev",
    // Фронтенд на GitHub Pages ходит в API с другого домена
    "ALLOWED_ORIGINS": "https://vreremenko.github.io"
  },
  "observability": { "enabled": true }
}
